{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.12",
		"@rocicorp/zero": "^1.9.0",
		"@zero-lag/catalog": "^0.0.0",
		"@zero-lag/env": "*",
		"@zero-lag/geo": "*",
		"@zero-lag/rules": "*",
		"@zero-lag/schema": "*",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.32",
		"jose": "^6.2.9",
		"ws": "^8.21.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"@types/ws": "^8.18.1",
		"@zero-lag/config": "*",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
