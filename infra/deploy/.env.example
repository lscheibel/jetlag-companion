# Copy to .env beside docker-compose.yml and fill in every value.
#
# There are no defaults on purpose. The development compose falls back to
# `password` and `dev-secret-change-me` so that `npm run docker:up` just works;
# on a public host that same fallback is a server running with a secret that is
# written down in the repository. compose refuses to start if any of these is
# missing.

# Public origin of the web app. Also the server's CORS_ORIGIN, because the API
# is served from /api on this same host.
APP_ORIGIN=https://jetlag.lennardscheibel.de

# openssl rand -base64 32
POSTGRES_PASSWORD=
ZERO_ADMIN_PASSWORD=

# Signs the game token (m0-spec §4). Minimum 16 characters; long-lived, so
# rotating it invalidates every outstanding join link.
# openssl rand -base64 32
GAME_TOKEN_SECRET=

# The image tag to run. `latest` follows main; a git SHA pins a deploy and is
# what makes a rollback a one-line edit.
IMAGE_TAG=latest

# The external Docker network Traefik is attached to. `docker network ls` to
# find its name.
TRAEFIK_NETWORK=traefik

# info | debug
ZERO_LOG_LEVEL=info
