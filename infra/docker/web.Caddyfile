{
	admin off
	# Traefik terminates TLS; this only ever speaks plain HTTP on the network
	# it shares with it. Without this Caddy would try to provision its own
	# certificate for a host it does not own.
	auto_https off
}

:3001 {
	root * /srv
	encode zstd gzip

	# Vite hashes every filename under /assets, so a URL there can never change
	# meaning — with two exceptions. MapLibre's worker pair is emitted under
	# fixed names because the runtime computes the URL from a string, so those
	# two URLs *do* change meaning when maplibre is upgraded. Marking them
	# immutable would hide the new version from returning browsers for a year.
	@immutable {
		path /assets/*
		not path /assets/maplibre-gl-worker.mjs /assets/maplibre-gl-shared.mjs
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Anything whose URL can outlive its contents. An autoUpdate PWA that cannot
	# revalidate its own service worker is a PWA that never updates.
	@volatile path / /index.html /sw.js /registerSW.js /manifest.webmanifest /assets/maplibre-gl-worker.mjs /assets/maplibre-gl-shared.mjs
	header @volatile Cache-Control "no-cache"

	# Go's mime table does not know this extension, and a manifest served as
	# application/octet-stream is a manifest the browser ignores.
	@webmanifest path *.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	# Hashed build output. A missing file here is a build bug, and it must 404
	# as one: handing it to the SPA fallback returns index.html with a 200, and
	# the browser reports "Failed to load module script: non-JavaScript MIME
	# type of text/html" — which says nothing about the file being absent.
	handle /assets/* {
		file_server
	}

	# SPA mode: every other route is index.html, and the client router takes it
	# from there. m2-spec — a route that needs a server round-trip to paint is
	# a route that does not exist underground.
	handle {
		try_files {path} /index.html
		file_server
	}
}
