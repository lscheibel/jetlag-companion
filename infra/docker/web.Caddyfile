{
	admin off
	# Traefik terminates TLS; this only ever speaks plain HTTP on the network
	# it shares with it. Without this Caddy would try to provision its own
	# certificate for a host it does not own.
	auto_https off
}

:3001 {
	root * /srv
	encode zstd gzip

	# Vite hashes every filename under /assets, so a URL there can never change
	# meaning. Anything else can, and an autoUpdate PWA that cannot revalidate
	# its own service worker is a PWA that never updates.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@volatile path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @volatile Cache-Control "no-cache"

	# Go's mime table does not know this extension, and a manifest served as
	# application/octet-stream is a manifest the browser ignores.
	@webmanifest path *.webmanifest
	header @webmanifest Content-Type "application/manifest+json"

	# SPA mode: every route is index.html, and the client router takes it from
	# there. m2-spec — a route that needs a server round-trip to paint is a
	# route that does not exist underground.
	try_files {path} /index.html
	file_server
}
